# Backend FastAPI Environment Configuration (Development)
PROJECT_NAME=LDKH Web GIS API
API_V1_STR=/api/v1

DATABASE_URL=postgresql+psycopg2://ldkh_admin:ldkh_dev_secret@localhost:5432/ldkh_gis

# Path ke mount point dokumen PDF (di lokal dapat menunjuk ke ../infra/mock-synology/LDKH-Documents)
SYNOLOGY_MOUNT_PATH=/mnt/synology/LDKH-Documents
NGINX_INTERNAL_PDF_PREFIX=/internal-pdf

# Security & Tokenized PDF URL
SECRET_KEY=change-this-in-production-hmac-secret
PDF_TOKEN_EXPIRE_SECONDS=900
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Google Gemini API (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
